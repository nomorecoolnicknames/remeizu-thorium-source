--- a/vendor/mediatek/ril/libril/Android.mk
+++ b/vendor/mediatek/ril/libril/Android.mk
@@ -40,6 +40,11 @@
 
 ril_cflags := -Wno-unused-parameter -DANDROID_SIM_COUNT_2 -DANDROID_MULTI_SIM -DMTK_HARDWARE
 
+# U10/U20 use RIL version 11 and five socket callbacks.
+ifneq ($(filter u10 u20,$(TARGET_DEVICE)),)
+  ril_cflags += -DMEIZU_NATIVE_RIL_V11
+endif
+
 # forge (m5c, 2026-09-03): RIL_InitialAttachApn is NOT the same struct on every
 # MTK blob. m681 (MT6755) reads a pointer at 0x10 and an int at 0x18, so it has
 # a roamingProtocol member; m5c (MT6737M) reads an int at 0x10 and a pointer at
@@ -52,7 +57,7 @@
 # FACT (llvm-objdump of requestSetInitialAttachApn in lib64/mtk-ril.so): m5c,
 # m5s and m2note all do "ldr w6, [xN, #16]; ldr x7, [xN, #24]" — an int at 0x10
 # and a pointer at 0x18, i.e. no roamingProtocol member.
-ifneq ($(filter m5c m5s m2note,$(TARGET_DEVICE)),)
+ifneq ($(filter m5c m5s m2note u10 u20,$(TARGET_DEVICE)),)
   ril_cflags += -DMTK_RIL_IAA_NO_ROAMING_PROTOCOL
 endif
 
