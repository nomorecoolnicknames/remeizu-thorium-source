Subject: [PATCH] vendorsetup: avoid remote lunch menu for explicit offline snapshots

Base: vendor/lineage 8c3b4f98ecde1eb40e08c7c26d95ce22d0130aa6

PROPER-FIX: envsetup sources vendorsetup before lunch. Its unconditional curl
fetches the remote menu even in an offline, read-only source snapshot. Guard
only that remote menu with the existing explicit flag; unset or other values
keep the original behavior, and local generic lunch choices always remain.

--- a/vendor/lineage/vendorsetup.sh
+++ b/vendor/lineage/vendorsetup.sh
@@ -1,7 +1,11 @@
-for combo in $(curl -s https://raw.githubusercontent.com/LineageOS/hudson/master/lineage-build-targets | sed -e 's/#.*$//' | grep lineage-16.0 | awk '{printf "lineage_%s-%s\n", $1, $2}')
-do
-    add_lunch_combo $combo
-done
+# Explicit offline snapshots already contain the selected product.
+# Keep the local generic combos; avoid fetching the remote interactive menu.
+if [ "${FORGE_OFFLINE_SOURCE_SNAPSHOT:-}" != "1" ]; then
+    for combo in $(curl -s https://raw.githubusercontent.com/LineageOS/hudson/master/lineage-build-targets | sed -e 's/#.*$//' | grep lineage-16.0 | awk '{printf "lineage_%s-%s\n", $1, $2}')
+    do
+        add_lunch_combo $combo
+    done
+fi
 
 add_lunch_combo lineage_arm-userdebug
 add_lunch_combo lineage_arm64-userdebug
