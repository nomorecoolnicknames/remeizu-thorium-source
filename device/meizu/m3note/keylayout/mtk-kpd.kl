# mtk-kpd.kl — Meizu M3 Note (m681), LOS 20 Treble.  Taken from the LOS 16 tree
# (los16-ct07/device/meizu/m681/keylayout/mtk-kpd.kl, sha256 38aa0a35…); only
# change: HOME carries WAKE (owner, 2026-09-29: the physical Home button must
# wake the screen).  Without this file the input stack falls back to Generic.kl,
# where scan code 102 is MOVE_HOME, not HOME.
# FACT (TWRP 3.10 kernel on this unit, /proc/bus/input/devices): mtk-kpd reports
# keys 102 HOME, 114/115 volume, 116 POWER.  HYPOTHESIS until getevent on the
# device shows it: the Home press (dome click) arrives here as scan 102, as the
# PMIC HOMEKEY does on m95.
key 399   GRAVE
key 2     1
key 3     2
key 4     3
key 5     4
key 6     5
key 7     6
key 8     7
key 9     8
key 10    9
key 11    0
key 158   BACK
key 230   SOFT_RIGHT
key 60    SOFT_RIGHT
key 107   ENDCALL
key 62    ENDCALL
# M681 has a single mBack front key, not a legacy Android menu key.
key 229   BACK
key 139   BACK
key 59    BACK
key 127   SYM
key 217   SEARCH
key 228   POUND
key 227   STAR
key 231   CALL
key 61    CALL
key 232   BACK
key 108   DPAD_DOWN
key 103   DPAD_UP
key 102   HOME              WAKE
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 115   VOLUME_UP
key 114   VOLUME_DOWN
key 113   MUTE
key 116   POWER
key 212   CAMERA
key 211   FOCUS
key 164   MEDIA_PLAY_PAUSE
key 128   MEDIA_STOP
key 163   MEDIA_NEXT
key 165   MEDIA_PREVIOUS
key 168   MEDIA_REWIND
key 159   MEDIA_FAST_FORWARD
