ro.hardware=mt6755
ro.remeizu.board_family=m3note
ro.sf.lcd_density=480
ro.sf.hwrotation=0
qemu.hw.mainkeys=0
ro.treble.enabled=false

# From the M681 LOS 20 treble tree (wt/device_m681_treble 7dd224c system.prop):
# no GL preload in zygote (Mali N driver), and the MTK RIL/AT/GNSS tags on INFO so
# that ICCID/IMSI/numbers/AT commands and coordinates do not go into the log.
ro.zygote.disable_gl_preload=true
log.tag.AT=I
log.tag.hal2mnl=I
log.tag.RIL=I
log.tag.RILC=I
log.tag.RILC-MTK=I
log.tag.RILC-RP=I
log.tag.RIL-CC=I
log.tag.RIL-DATA=I
log.tag.RIL-DSBP=I
log.tag.RIL-EMBMS=I
log.tag.RIL-NW=I
log.tag.RIL-OEM=I
log.tag.RIL-PHB=I
log.tag.RIL-RP=I
log.tag.RIL-SIM=I
log.tag.RIL-SMS=I
log.tag.RIL-SS=I
log.tag.RIL-STK=I
log.tag.RIL-UFP=I
