# --- types for nodes that were plain "device" / "socket_device" / data -------
type hwmsensor_device, dev_type;
type mtk_mal_socket, file_type;
type agps_data_file, file_type, data_file_type;
type proc_lk_env, fs_type, proc_type;
type sysfs_sensor, fs_type, sysfs_type;

# --- modem: ccci, mux, rild, MAL --------------------------------------------
allow ccci_fsd system_data_file:lnk_file read;
allow ccci_mdinit system_data_file:lnk_file read;
allow ccci_mdinit sysfs_dev_info:file r_file_perms;
allow ccci_mdinit sysfs:file w_file_perms;
allow gsm0710muxd ccci_device:chr_file rw_file_perms;
allow gsm0710muxd radio_device:dir create_dir_perms;
allow gsm0710muxd radio_device:lnk_file create_file_perms;
allow gsm0710muxd devpts:chr_file setattr;
allow gsm0710muxd self:capability { chown fowner };
allow rild proc_lk_env:file { r_file_perms ioctl };
allow rild mtk_mal_socket:sock_file write;
allow rild mtk_mtkmal:unix_stream_socket connectto;
allow mtk_mtkmal mtk_mal_socket:sock_file write;
allow mtk_mtkmal rild:unix_stream_socket connectto;
allow nvram_daemon self:capability fsetid;
allow nvram_daemon system_data_file:lnk_file read;

# --- GPS ---------------------------------------------------------------------
allow mtk_agpsd self:udp_socket create_socket_perms;
allow mtk_agpsd agps_data_file:dir create_dir_perms;
allow mtk_agpsd agps_data_file:sock_file create_file_perms;
allow mtk_mnld agps_data_file:dir search;
allow mtk_mnld agps_data_file:sock_file write;
allow mtk_mnld mtk_agpsd:unix_dgram_socket sendto;
allow mtk_wifi2agps agps_data_file:dir search;
allow mtk_wifi2agps agps_data_file:sock_file write;
allow mtk_wifi2agps mtk_agpsd:unix_dgram_socket sendto;
allow mtk_wifi2agps self:netlink_generic_socket create_socket_perms_no_ioctl;
allow hal_gnss_default mtk_mnld:unix_dgram_socket sendto;

# --- connectivity ------------------------------------------------------------
allow mtk_wmt_launcher stpwmt_device:chr_file { rw_file_perms ioctl };
allow hal_bluetooth_default stpbt_device:chr_file rw_file_perms;
allow hal_bluetooth_default nvdata_file:dir search;
allow hal_bluetooth_default nvdata_file:file r_file_perms;
allow hal_bluetooth_default system_data_file:lnk_file read;

# --- audio, sensors, lights --------------------------------------------------
allow hal_audio_default nvdata_file:dir search;
allow hal_audio_default nvdata_file:file r_file_perms;
allow hal_audio_default system_data_file:lnk_file read;
allow hal_sensors_default hwmsensor_device:chr_file { rw_file_perms ioctl };
allow hal_sensors_default sysfs_sensor:dir r_dir_perms;
allow hal_sensors_default sysfs_sensor:file rw_file_perms;
allow hal_light_default sysfs_leds:dir r_dir_perms;
allow hal_light_default sysfs_leds:file rw_file_perms;

# --- battery / logging daemons ----------------------------------------------
allow fuelgauged self:netlink_socket create_socket_perms_no_ioctl;
allow emdlogger file_contexts_file:file r_file_perms;

allow init { vendor_file vendor_configs_file }:file mounton;
