# Own U20 core and calibration mounts; calibration is never auto-formatted.
# Stock metadata encryption is retained; mount/runtime compatibility is unverified.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system /system ext4 ro wait
