# MTK project .rc configure

on init
    mkdir /mnt/media_rw/usbotg 0700 media_rw media_rw
    mkdir /storage/usbotg 0700 root root

on post-fs-data

#
# Connectivity related device nodes & configuration (begin)
#

#/dev/ttyMT2 for Connectivity BT/FM/GPS usage
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2


# STP, WMT, GPS, FM and BT Driver
#   insmod /system/lib/modules/mtk_hif_sdio.ko
#   insmod /system/lib/modules/mtk_stp_wmt.ko
#   insmod /system/lib/modules/mtk_stp_uart.ko
#   insmod /system/lib/modules/mtk_stp_gps.ko
#   insmod /system/lib/modules/mtk_stp_bt.ko
#   insmod /system/lib/modules/mtk_fm_drv.ko
#   insmod /system/lib/modules/mtk_wmt_wifi.ko


# WMT/GPS/BT/FM/WIFI nodes are created by kernel uevents and labeled by ueventd.

    chmod 0660 /dev/stpwmt
    chown system system /dev/stpwmt
    restorecon /dev/stpwmt

    chmod 0660 /dev/stpgps
    chown gps gps /dev/stpgps
    restorecon /dev/stpgps

    chmod 0660 /dev/stpbt
    chown bluetooth radio /dev/stpbt
    restorecon /dev/stpbt

    chmod 0660 /dev/wmtdetect
    chown system system /dev/wmtdetect

    chmod 0660 /dev/wmtWifi
    chown wifi wifi /dev/wmtWifi
    restorecon /dev/wmtWifi

#Camera
    chmod 0660 /dev/GAF001AF
    chown system camera /dev/GAF001AF
   
    chmod 0660 /dev/DW9714AF
    chown system camera /dev/DW9714AF

    chmod 0660 /dev/LC898122AF
    chown system camera /dev/LC898122AF

    chmod 0660 /dev/LC898212AF
    chown system camera /dev/LC898212AF

    chmod 0660 /dev/LC898214AF
    chown system camera /dev/LC898214AF
    
    chmod 0660 /dev/AD5820AF
    chown system camera /dev/AD5820AF
    
    chmod 0660 /dev/BU6424AF
    chown system camera /dev/BU6424AF

    chmod 0660 /dev/BU6429AF
    chown system camera /dev/BU6429AF
    
    chmod 0660 /dev/BU64745GWZAF
    chown system camera /dev/BU64745GWZAF

    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

    chmod 0660 /dev/MAINAF2
    chown system camera /dev/MAINAF2

    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

    chmod 0660 /dev/stmvl6180
    chown system camera /dev/stmvl6180

#SMB
    chown system system /proc/smb/ScreenComm
    chmod 0660 /proc/smb/ScreenComm
 
# BT
    chmod 0660 /dev/stpbt
    chown bluetooth radio /dev/stpbt
    restorecon /dev/stpbt

# GPS
#    chown gps gps /dev/stpgps
    chown gps gps /sys/class/gpsdrv/gps/pwrctl
    chown gps gps /sys/class/gpsdrv/gps/suspend
    chown gps gps /sys/class/gpsdrv/gps/state
    chown gps gps /sys/class/gpsdrv/gps/pwrsave
    chown gps gps /sys/class/gpsdrv/gps/status
#    chmod 0660 /dev/stpgps

# WiFi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    chown wifi wifi /data/misc/wifi

#Define device for ATCID
    chmod 660 /dev/ttyGS0 
    chown system /dev/ttyGS0 
    chmod 660 /dev/ttyGS1 
    chown system /dev/ttyGS1

#Disable for one Single loader
# Load WiFi Driver
#   insmod /system/lib/modules/wlan_mt.ko

# Char device for BT 3.0 HS
    chown bluetooth bluetooth /dev/ampc0
    chmod 0660 /dev/ampc0
    restorecon /dev/ampc0

# Speaker amplifier
    chown system audio /dev/aw8738
    chmod 0660 /dev/aw8738
    restorecon /dev/aw8738

#FLYME:zhouyueguo@SHELL.FlymeBenchMarkMTK.Feature {@
    chown system system /sys/power/power_mode
    chmod 0660 /sys/power/power_mode
# @}

#
# Connectivity related device nodes & configuration (end)
#

#    chmod 0660 /dev/spm
#    chown system system /dev/spm

# Encrypt phone function
    setprop vold.post_fs_data_done 1

on init
    # Refer to http://source.android.com/devices/tech/storage/index.html
    # It said, "Starting in Android 4.4, multiple external storage devices are surfaced to developers through
    #           Context.getExternalFilesDirs(), Context.getExternalCacheDirs(), and Context.getObbDirs().
    #           External storage devices surfaced through these APIs must be a semi-permanent part of the device (such as an SD card slot in a battery compartment).
    #           Developers expect data stored in these locations to be available over long periods of time."
    # Therefore, if the target doesn't support sd hot-plugging (Ex: the SD card slot in a battery compartment), we need to export SECONDARY_STORAGE in 'boot' section
    #
    # export SECONDARY_STORAGE /storage/sdcard1

service fuse_usbotg /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/usbotg /storage/usbotg
    class late_start
    disabled

#
# Connectivity related services (Begin)
#

service atci_service /system/vendor/bin/atci_service 
	socket atci-service stream 660 radio system 
	socket atci-serv-fw stream 660 radio system 
	user root 
        disabled
	group radio system                         
service atcid-daemon-u /vendor/bin/atcid
	user system
	group radio system media
	disabled
	oneshot

service atcid-daemon-e /vendor/bin/atcid
	user root
	group radio system
	disabled
	oneshot

on property:ro.build.type=eng
    # Build Station pure64 isolation: stock atci_service is a 32-bit vendor
    # binary in this blobset and loops with Exec format error.
    start atcid-daemon-e

on property:persist.service.atci.autostart=1
    # Build Station pure64 isolation: leave atci_service disabled until a
    # matching 64-bit binary or 32-bit userspace slice is restored.
    start atcid-daemon-u

service audio-daemon /vendor/bin/audiocmdservice_atci
    class main
    socket atci-audio stream 660 media system
    user media
    group nvram media system sdcard_rw
    disabled
    oneshot

service wmtLoader /system/vendor/bin/wmt_loader
   user root
   group root
   class core
   oneshot


# M6: integrated CONSYS 0x0326 needs the launcher daemon alive to answer the
# kernel's srh_patch requests (it feeds ROMv2_lm_patch_*_hdr.bin over /dev/stpwmt).
# Stock Flyme runs it auto-started (class core, no disabled). NOTE: this
# LineageOS wmt_launcher binary exits with usage on a "-n <patch>" argument —
# do not add it; "-m 3 -p <dir>" is the working invocation.
service conn_launcher /vendor/bin/wmt_launcher -m 3 -p /vendor/firmware
   user system
   group system
   class core

on boot
    start conn_launcher

on property:service.wcn.coredump.mode=2
    start stp_dump

service stp_dump /system/vendor/bin/stp_dump3
    user root
    group root
    class core
    disabled
    oneshot

#
# Connectivity related services (End)
#

service spm_script /vendor/bin/spm_loader
    user root
    group root
    class core
    oneshot


#FLYME:fanjun@SHELL.HapticFeedback.Feature {@
on init
    chown system system /dev/tspdrv
    chmod 0660 /dev/tspdrv

    mkdir /dev/pipes 0771 system system
    export VIBE_PIPE_PATH /dev/pipes
    
# TouchSense Player Service
service immvibed /system/bin/immvibed -p 99 -u 1000
    class main
    disabled
    oneshot
    user root
    group root
#@}

# Build Station: MTK adb peripheral mode
on property:sys.usb.config=adb && property:sys.usb.configfs=0
    write /sys/devices/platform/11270000.usb3/musb-hdrc/cmode 1
    write /dev/kmsg "Build Station USB: adb cmode=1"

on property:sys.usb.config=adb
    write /sys/devices/platform/11270000.usb3/musb-hdrc/cmode 1
