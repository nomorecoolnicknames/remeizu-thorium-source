on init
    mkdir /nvdata 0771 system system

on post-fs-data
    chown root system /nvdata
    chmod 0771 /nvdata
    restorecon_recursive /nvdata

    # MTK libnvram opens fixed /data/nvram/* paths.  /nvdata is the mounted
    # stock NVDATA partition, so bind it over /data/nvram instead of creating
    # an empty userdata directory or a symlink that cannot replace it.
    copy /fstab.mt6755 /nvdata/fstab.mt6755
    chown root root /nvdata/fstab.mt6755
    chmod 0644 /nvdata/fstab.mt6755
    restorecon /nvdata/fstab.mt6755
    mkdir /data/nvram 0771 root system
    mount none /nvdata /data/nvram bind
    chown root system /data/nvram
    chmod 0771 /data/nvram
    copy /fstab.mt6755 /data/nvram/fstab.mt6755
    chown root root /data/nvram/fstab.mt6755
    chmod 0644 /data/nvram/fstab.mt6755
    restorecon /data/nvram/fstab.mt6755

    # libcustom_nvram opens these paths from audioserver; keep traversal open
    # while preserving media-group write access for audio calibration records.
    mkdir /data/nvram/media 0770 root media
    chown root media /data/nvram/media
    chmod 0770 /data/nvram/media
    mkdir /data/nvram/APCFG 0771 root system
    mkdir /data/nvram/APCFG/APRDCL 0771 root system
    mkdir /data/nvram/APCFG/APRDEB 0771 root system
    chmod 0771 /data/nvram/APCFG
    chmod 0771 /data/nvram/APCFG/APRDCL
    chmod 0771 /data/nvram/APCFG/APRDEB
    restorecon_recursive /data/nvram

on property:service.nvram_init=Ready
    copy /fstab.mt6755 /nvdata/fstab.mt6755
    chown root root /nvdata/fstab.mt6755
    chmod 0644 /nvdata/fstab.mt6755
    restorecon /nvdata/fstab.mt6755
    copy /fstab.mt6755 /data/nvram/fstab.mt6755
    chown root root /data/nvram/fstab.mt6755
    chmod 0644 /data/nvram/fstab.mt6755
    restorecon /data/nvram/fstab.mt6755
    chmod 0771 /nvdata
    chmod 0771 /data/nvram
