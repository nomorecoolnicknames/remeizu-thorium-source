vndbinder_use(hal_camera_default)

allow hal_camera_default mtk_camera_device:chr_file rw_file_perms;
allow hal_camera_default mtk_camera_device:chr_file ioctl;
allow hal_camera_default mtk_smi_device:chr_file rw_file_perms;
allow hal_camera_default mtk_smi_device:chr_file ioctl;
allow hal_camera_default mtk_m4u_proc:file rw_file_perms;
allow hal_camera_default mtk_cmdq_proc:file rw_file_perms;
allow hal_camera_default mtk_cmdq_proc:file ioctl;
allow hal_camera_default mtk_devinfo_sysfs:dir r_dir_perms;
allow hal_camera_default mtk_devinfo_sysfs:file r_file_perms;
allow hal_camera_default mtk_devinfo_sysfs:lnk_file read;
