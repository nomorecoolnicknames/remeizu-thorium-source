allow init { protect_f_data_file protect_s_data_file custom_file radio_data_file }:dir mounton;
allow init { mtk_netdiag_socket mtk_wod_socket mtk_agpsd_socket mtk_mnld_socket }:sock_file { create setattr unlink };
allow fsck { protect_block_device nvdata_block_device custom_block_device }:blk_file rw_file_perms;
allow e2fs { protect_block_device nvdata_block_device custom_block_device }:blk_file rw_file_perms;
allow init { mtk_ccci_aud_device sunwave_fp_device }:chr_file getattr;
allow init mtk_wmt_device:chr_file rw_file_perms;
allow netd mtk_wmt_device:chr_file rw_file_perms;
allow hal_wifi_default mtk_wmt_device:chr_file rw_file_perms;
allow hal_bluetooth_default mtk_stp_device:chr_file rw_file_perms;
