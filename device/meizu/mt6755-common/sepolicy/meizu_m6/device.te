type mtk_ccci_device, dev_type;
type mtk_wmt_device, dev_type;
type mtk_stp_device, dev_type;
type aw8738_device, dev_type;
type mtk_disp_mgr_device, dev_type;
type mtk_sw_sync_device, dev_type;
type mtk_spm_device, dev_type;
type mtk_hwmsensor_device, dev_type;
type mtk_gpufreq_proc, fs_type;
type mtk_cmdq_proc, fs_type;
type mtk_wmt_proc, fs_type;
type mtk_devinfo_sysfs, sysfs_type, fs_type;
type mtk_backlight_sysfs, sysfs_type, fs_type;
type mtk_sensor_sysfs, sysfs_type, fs_type;
type protect_f_data_file, file_type, data_file_type;
type protect_s_data_file, file_type, data_file_type;
type custom_file, file_type;
type mtk_mblog_data_file, file_type, data_file_type;
type mtk_mdlog_data_file, file_type, data_file_type;
