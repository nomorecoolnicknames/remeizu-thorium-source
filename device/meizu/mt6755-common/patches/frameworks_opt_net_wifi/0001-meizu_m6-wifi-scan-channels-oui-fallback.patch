+    /**
+     * Default channel list when the vendor HAL cannot enumerate channels
+     * (getValidFrequenciesForBand -> ERROR_NOT_SUPPORTED on this MTK driver).
+     * band is a WifiScanner.WIFI_BAND_* bitmask (bit0=2.4GHz, bit1=5GHz, bit2=5GHz-DFS).
+     */
+    private int[] getDefaultChannelsForBand(int band) {
+        ArrayList<Integer> f = new ArrayList<>();
+        if ((band & 0x1) != 0) {                       // 2.4 GHz ch 1-13
+            for (int ch = 1; ch <= 13; ch++) f.add(2407 + ch * 5);
+        }
+        if ((band & 0x2) != 0) {                       // 5 GHz non-DFS
+            int[] c = {5180, 5200, 5220, 5240, 5745, 5765, 5785, 5805, 5825};
+            for (int x : c) f.add(x);
+        }
+        if ((band & 0x4) != 0) {                       // 5 GHz DFS
+            int[] c = {5260, 5280, 5300, 5320, 5500, 5520, 5540, 5560, 5580, 5660, 5680, 5700};
+            for (int x : c) f.add(x);
+        }
+        return intArrayFromArrayList(f);
+    }
