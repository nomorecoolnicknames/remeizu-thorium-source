+    private boolean parseMacOui(String oui, byte[] ouiBytes) {
+        if (TextUtils.isEmpty(oui)) {
+            return false;
+        }
+        String[] ouiParts = oui.split("-");
+        if (ouiParts.length != 3) {
+            return false;
+        }
+        try {
+            for (int i = 0; i < ouiParts.length; i++) {
+                int ouiPart = Integer.parseInt(ouiParts[i], 16);
+                if (ouiPart < 0 || ouiPart > 0xFF) {
+                    return false;
+                }
+                ouiBytes[i] = (byte) ouiPart;
+            }
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
