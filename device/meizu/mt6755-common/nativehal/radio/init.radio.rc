on post-fs-data
    symlink /nvdata /data/nvram
    symlink /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram /dev/nvram
    mkdir /data/ccci_cfg 0770 system radio
    restorecon /data/ccci_cfg
    chown radio radio /sys/kernel/ccci/boot
    start meizu-calibration-check

service meizu-calibration-check /system/bin/meizu-calibration-ready
    class main
    user root
    group root system radio
    disabled
    oneshot

on property:sys.meizu.calibration.mounted=1
    start nvram_daemon
    start ccci_fsd

on property:sys.meizu.calibration.mounted=1 && property:service.nvram_init=Ready
    start ccci_mdinit

service nvram_daemon /system/bin/nvram_daemon
    class main
    user root
    group system
    disabled
    oneshot

service ccci_fsd /system/bin/ccci_fsd 0
    class core
    user radio
    group radio system
    disabled
    oneshot

service ccci_mdinit /system/bin/ccci_mdinit 0
    class core
    user system
    group radio system
    disabled
    oneshot

service gsm0710muxd /system/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot

# Own ccci_mdinit starts this exact service name after modem initialization.
# The executable is the source SDK28 HIDL bridge, not Android 6 mtkrild.
service ril-daemon-mtk /vendor/bin/hw/rild -l /vendor/lib64/mtk-ril.so -- -d /dev/ttyC0
    interface android.hardware.radio@1.0::IRadio slot1
    interface android.hardware.radio@1.0::IRadio slot2
    interface android.hardware.radio.deprecated@1.0::ISap slot1
    interface android.hardware.radio.deprecated@1.0::ISap slot2
    class main
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket rild-mal stream 660 radio system
    socket rild-mal-at stream 660 radio system
    socket rild-vsim stream 660 root radio
    socket rild-mbim stream 660 root radio
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    socket sap_uim_socket2 stream 660 bluetooth bluetooth
    disabled
    oneshot
