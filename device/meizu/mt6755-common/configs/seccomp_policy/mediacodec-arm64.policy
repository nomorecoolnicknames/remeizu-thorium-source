# Organized by expected mediacodec service frequency, using arm64 syscall names.
futex: 1
ioctl: 1
write: 1
writev: 1
prctl: 1
clock_gettime: 1
getpriority: 1
getrlimit: 1
setpriority: 1
read: 1
close: 1
dup: 1
ppoll: 1
mmap: 1
mremap: arg3 == 3
munmap: 1
mprotect: 1
madvise: 1
openat: 1
getrandom: 1
getuid: 1
geteuid: 1
getgid: 1
getegid: 1
getgroups: 1
fstat: 1
fstatfs: 1
statfs: 1
newfstatat: 1
pread64: 1
faccessat: 1
readlinkat: 1
lseek: 1
getdents64: 1
fcntl: 1
sigaltstack: 1
clone: 1
rt_sigprocmask: 1
rt_sigaction: 1
rt_sigreturn: 1
set_tid_address: 1
sched_yield: 1
sched_setscheduler: 1
sched_get_priority_max: 1
sched_get_priority_min: 1
nanosleep: 1
gettimeofday: 1
restart_syscall: 1
pipe2: 1
socket: 1
connect: 1
recvmsg: 1
rt_tgsigqueueinfo: 1
tgkill: 1
getpid: 1
gettid: 1
exit: 1
exit_group: 1
